"""Type stub for the native ``auniqorm_native`` Rust extension (PyO3).

Hand-written to match ``rust/src/{pg,sqlite,mysql,mongo}.rs``:

* SQLite engine methods are synchronous (rusqlite runs with the GIL released).
* PostgreSQL and MySQL engine/transaction methods are asynchronous
  (``pyo3_async_runtimes`` turns each into an awaitable).

``params`` accepts a sequence of bind values or ``None``; rows come back as
``{column: value}`` dicts, or as a msgpack buffer for ``msgspec`` to decode.

PostgreSQL/MySQL handles (``PgTransaction``/``MySqlTransaction``) come in two
modes. ``engine.begin()`` returns one in *transaction* mode (``BEGIN`` issued);
``commit()``/``rollback()`` end the transaction, reset the session and return
the connection to the pool, closing the handle (MySQL resolves once
COMMIT/ROLLBACK completes and resets in the background; the connection is not
reused until the reset has finished). ``engine.acquire()`` returns
one in *pinned* mode: ``begin()``/``commit()``/``rollback()`` run on the pinned
connection, which stays pinned until ``release()``. ``release()`` (both modes,
idempotent) rolls back, resets and returns the connection. Any operation on a
closed handle raises ``RuntimeError("... already ended")``. A handle dropped
while still pinned is rolled back and reset in the background before its
connection is reused.
"""

from typing import Any

_Params = list[Any] | None
_Row = dict[str, Any]

class SqliteEngine:
    def execute(self, sql: str, params: _Params) -> int: ...
    def fetch_all(self, sql: str, params: _Params) -> list[_Row]: ...
    def fetch_one(self, sql: str, params: _Params) -> _Row | None: ...
    def fetch_all_msgpack(self, sql: str, params: _Params) -> bytes: ...
    def fetch_one_msgpack(self, sql: str, params: _Params) -> bytes | None: ...
    def begin(self) -> None: ...
    def commit(self) -> None: ...
    def rollback(self) -> None: ...
    def close(self) -> None: ...

class PgTransaction:
    @property
    def closed(self) -> bool: ...
    async def execute(self, sql: str, params: _Params) -> int: ...
    async def fetch_all(self, sql: str, params: _Params) -> list[_Row]: ...
    async def fetch_one(self, sql: str, params: _Params) -> _Row | None: ...
    async def fetch_all_msgpack(self, sql: str, params: _Params) -> bytes: ...
    async def fetch_one_msgpack(self, sql: str, params: _Params) -> bytes | None: ...
    async def begin(self) -> None: ...
    async def commit(self) -> None: ...
    async def rollback(self) -> None: ...
    async def release(self) -> None: ...

class PgEngine:
    async def execute(self, sql: str, params: _Params) -> int: ...
    async def fetch_all(self, sql: str, params: _Params) -> list[_Row]: ...
    async def fetch_one(self, sql: str, params: _Params) -> _Row | None: ...
    async def fetch_all_msgpack(self, sql: str, params: _Params) -> bytes: ...
    async def fetch_one_msgpack(self, sql: str, params: _Params) -> bytes | None: ...
    async def begin(self) -> PgTransaction: ...
    async def acquire(self) -> PgTransaction: ...
    async def close(self) -> None: ...

class MySqlTransaction:
    @property
    def closed(self) -> bool: ...
    async def execute(self, sql: str, params: _Params) -> int: ...
    async def fetch_all(self, sql: str, params: _Params) -> list[_Row]: ...
    async def fetch_one(self, sql: str, params: _Params) -> _Row | None: ...
    async def fetch_all_msgpack(self, sql: str, params: _Params) -> bytes: ...
    async def fetch_one_msgpack(self, sql: str, params: _Params) -> bytes | None: ...
    async def begin(self) -> None: ...
    async def commit(self) -> None: ...
    async def rollback(self) -> None: ...
    async def release(self) -> None: ...

class MySqlEngine:
    async def execute(self, sql: str, params: _Params) -> int: ...
    async def fetch_all(self, sql: str, params: _Params) -> list[_Row]: ...
    async def fetch_one(self, sql: str, params: _Params) -> _Row | None: ...
    async def fetch_all_msgpack(self, sql: str, params: _Params) -> bytes: ...
    async def fetch_one_msgpack(self, sql: str, params: _Params) -> bytes | None: ...
    async def begin(self) -> MySqlTransaction: ...
    async def acquire(self) -> MySqlTransaction: ...
    async def close(self) -> None: ...

class MongoSession:
    def end_if_unused(self) -> bool: ...
    async def commit(self) -> None: ...
    async def abort(self) -> None: ...

class MongoCursor:
    async def next_batch(self) -> bytes | None: ...
    def close(self) -> None: ...

class MongoEngine:
    async def execute_bson(
        self, command: bytes, session: MongoSession | None = None
    ) -> int | bytes: ...
    async def fetch_bson(
        self, command: bytes, session: MongoSession | None = None
    ) -> tuple[bytes, MongoCursor | None]: ...
    async def bulk_write_bson(
        self, command: bytes, session: MongoSession | None = None
    ) -> bytes: ...
    async def open_cursor_bson(
        self, command: bytes, batch_size: int
    ) -> MongoCursor: ...
    def begin_transaction(self) -> MongoSession: ...
    async def close(self) -> None: ...

def connect_sqlite(path: str) -> SqliteEngine: ...
async def connect_pg(
    url: str,
    sslmode: str | None = None,
    sslrootcert: str | None = None,
    max_size: int = 10,
    min_size: int = 1,
) -> PgEngine: ...
async def connect_mysql(
    url: str,
    ssl_mode: str | None = None,
    max_size: int | None = None,
    min_size: int | None = None,
) -> MySqlEngine: ...
async def connect_mongo(url: str, database: str) -> MongoEngine: ...
